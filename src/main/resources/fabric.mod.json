{
  "schemaVersion": 1,
  "id": "polybars",
  "version": "${version}",
  "name": "PolyBars",
  "description": "Library mod for server side resource bars!",
  "authors": ["elytrafae"],
  "contact": {
    "github": "https://github.com/elytrafae"
  },
  "license": "LGPL-3.0",
  "icon": "assets/polybars/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "xyz.elytrafae.mc.polybars.PolyBars"
    ]
  },
  "mixins": [
    "polybars.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "polymer-bundled": ">=${polymer_version}"
  }
}
